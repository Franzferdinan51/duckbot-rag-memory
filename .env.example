# DuckBot RAG + Memory - environment configuration
# Copy this to .env and fill in the keys for whichever providers you want enabled.
# The live deployment (brain on Robin, LM Studio on the Mac) uses LM Studio only.

# ============================================================================
# Embedding providers (at least ONE is required)
# ============================================================================
# DUCKBOT_EMBEDDING selects the active provider. Default: auto-detect.
# Options: "lmstudio" | "openai" | "local" | "nvidia" | "minimax" (deprecated, explicit-only)
#
# Auto-detect order when DUCKBOT_EMBEDDING is unset:
#   1. LM Studio reachable      -> lmstudio   (DEFAULT, the live path)
#   2. OPENAI_API_KEY set       -> openai
#   3. sentence-transformers    -> local
#   4. none                     -> error
# MiniMax is never auto-detected (removed 2026-11-26).

# --- LM Studio (local, dim from model) — the live provider ---
# Load `text-embedding-nomic-embed-text-v1.5` for embeddings (768-dim).
# Load `qwen3-reranker-0.6b` if you want the local rerank path.
# LMSTUDIO_URL=http://127.0.0.1:1234/v1
# LMSTUDIO_MODEL=text-embedding-nomic-embed-text-v1.5
# LMSTUDIO_RERANK_MODEL=qwen3-reranker-0.6b
# LMSTUDIO_API_KEY=<redacted>
# LMSTUDIO_EMBED_DIM=768

# --- OpenAI (cloud fallback, 1536d) ---
# OPENAI_API_KEY=<redacted>
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- MiniMax (cloud, 1536d) — DEPRECATED, explicit DUCKBOT_EMBEDDING=minimax only ---
# MINIMAX_API_KEY=<redacted>
# MINIMAX_BASE_URL=https://api.minimax.io/v1
# MINIMAX_EMBED_MODEL=text-embedding-01

# --- sentence-transformers (offline, no API) ---
# pip install sentence-transformers
# DUCKBOT_EMBEDDING=local

# ============================================================================
# Hermes integration (the brain serves Hermes + Juno only — Duckets, 2026-11-23)
# ============================================================================
HERMES_HOME=~/.hermes
# OPENCLAW_WORKSPACE / OPENCLAW_MEMORY are legacy: the OpenClaw connector is
# kept for compatibility but is not part of the live deployment.

# ============================================================================
# Scheduling
# ============================================================================
# Live jobs run as systemd user timers on Robin (see README deployed-jobs
# table). scripts/cron.sh is deprecated since v0.15.0.
# PYTHON_BIN=~/duckbot-rag-memory/.venv/bin/python
